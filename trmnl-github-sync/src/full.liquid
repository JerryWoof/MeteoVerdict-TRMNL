</div>{%- if rain_text != "" -%}<div class="say"><span class="l">{{ rain_lab }}</span>{% if rain_clock != "" %}<span class="c">{{ rain_clock }}</span>{% endif %}{% if w_rain >= 0.1 %}<small>{% assign n = w_rain %}{%- assign d1 = n | round: 1 -%}{%- assign d1i = d1 | floor -%}{%- if d1 == d1i -%}{{ d1i }}{%- else -%}{{ d1 | replace: ".", T_dec }}{%- endif %} mm{% if w_chance >= 0.05 %} · {{ w_chance | times: 100 | round }} % {{ T_chance }}{% endif %}</small>{% endif %}</div>{%- else -%}<div style="flex:1"></div>{%- endif -%}<div class="side">{%- if w_hi > -99 -%}<div class="what">{{ T_high }} {{ w_hi | round }}° · {{ T_low }} {{ w_lo | round }}°</div>{%- endif -%}{%- if sun_a != "" -%}<div class="mv-sun">{{ sun_a }}</div><div class="mv-sun">{{ sun_b }}</div>{%- endif -%}</div>
</div>
<div class="mv-facts">
<div class="mv-fact"><span>{{ T_rain }}</span><b>{% assign n = w_rain %}{%- assign d1 = n | round: 1 -%}{%- assign d1i = d1 | floor -%}{%- if d1 == d1i -%}{{ d1i }}{%- else -%}{{ d1 | replace: ".", T_dec }}{%- endif %} mm</b><i>{% if w_snow >= 0.1 %}{% assign n = w_snow %}{%- assign d1 = n | round: 1 -%}{%- assign d1i = d1 | floor -%}{%- if d1 == d1i -%}{{ d1i }}{%- else -%}{{ d1 | replace: ".", T_dec }}{%- endif %} cm{% else %}{{ w_chance | times: 100 | round }} % {{ T_chance }}{% endif %}</i></div>
<div class="mv-fact"><span>{{ T_sunshine }}</span><b>{%- assign n = w_sun | divided_by: 3600.0 -%}{%- assign d1 = n | round: 1 -%}{%- assign d1i = d1 | floor -%}{%- if d1 == d1i -%}{{ d1i }}{%- else -%}{{ d1 | replace: ".", T_dec }}{%- endif %} h</b><i>{% if light_h > 0 %}{{ T_of }} {{ light_h | divided_by: 60 | floor }} h {{ light_h | modulo: 60 }} min{% endif %}</i></div>
<div class="mv-fact"><span>{{ T_clouds }}</span><b>{{ w_cloud }} %</b><i>{{ T_mean }}</i></div>
<div class="mv-fact"><span>{{ T_wind }}</span><b>{{ w_wind | times: wind_k | round }} {{ wind_unit }}</b><i>{{ T_gusts_l }} {{ w_gust | times: wind_k | round }}</i></div>
<div class="mv-fact"><span>{{ T_pressure }}</span><b>{% if p_now != nil %}{{ p_now | round }} hPa{% else %}–{% endif %}</b><i>{{ p_trend }}&nbsp;</i></div>
<div class="mv-fact"><span>{{ T_humidity }}</span><b>{% if rh_now != nil %}{{ rh_now | round }} %{% else %}–{% endif %}</b><i>{% if dew_now != nil %}{{ T_dew }} {{ dew_now | round }}°{% endif %}&nbsp;</i></div>
</div>
<div class="cells">{{ cells }}</div>
<svg class="mv-chart" width="{{ gw }}" height="{{ gh }}" viewBox="0 0 {{ gw }} {{ gh }}">
<g fill="url(#mv-night)" shape-rendering="crispEdges">{{ shade }}</g>
{{ marks }}
<g fill="#000" shape-rendering="crispEdges">{{ bars }}</g>
<polyline points="{{ pts | strip }}" fill="none" stroke="#000" stroke-width="3.5" stroke-linejoin="round" stroke-linecap="round"/>{%- if w_hi > -99 -%}{%- assign lx_max = gw | minus: 16 -%}{%- assign lx = x_hi | times: gk | at_least: 16 | at_most: lx_max | round -%}{%- assign ly = w_top | minus: w_hi | times: g_curve | divided_by: w_span | plus: g_top | minus: 7 | round -%}<text x="{{ lx }}" y="{{ ly }}" text-anchor="middle" class="mv-lab">{{ w_hi | round }}°</text>{%- assign lx = x_lo | times: gk | at_least: 16 | at_most: lx_max | round -%}{%- assign ly = w_top | minus: w_lo | times: g_curve | divided_by: w_span | plus: g_top | plus: 20 | round -%}<text x="{{ lx }}" y="{{ ly }}" text-anchor="middle" class="mv-lab">{{ w_lo | round }}°</text>{%- endif -%}<path d="M0 {{ g_floor | plus: 1 }}H{{ gw }}" stroke="#000" stroke-width="2" shape-rendering="crispEdges"/>
</svg>
</div>{%- endcase -%}{%- endif -%}</div>{%- if lang == "cs" -%}{%- assign gmo = generated_local | date: "%m" | plus: 0 -%}{%- assign gdate = generated_local | date: "%d" | plus: 0 | append: ". " | append: gmo | append: "." -%}{%- else -%}{%- assign gmo = generated_local | date: "%m" | plus: 0 | minus: 1 -%}{%- assign gdate = T_months[gmo] | slice: 0, 3 -%}{%- assign gdate = generated_local | date: "%d" | plus: 0 | append: " " | append: gdate -%}{%- endif -%}{%- assign gtime = generated_local | date: "%H:%M" -%}{%- assign gday = generated_local | date: "%Y-%m-%d" -%}<div class="title_bar">
<span class="title">{{ place }}</span>{%- if stale -%}<span class="instance"><span class="mv-badge">{{ T_stale }}</span> {{ T_updated }} {{ gdate }} {{ gtime }}</span>{%- else -%}<span class="instance">{% if ai %}{{ T_ai }}{% else %}MeteoVerdict{% endif %} · {{ now_local | date: "%H:%M" }}</span>{%- endif -%}</div>
