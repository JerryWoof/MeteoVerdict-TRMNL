{%- comment -%}
  Saturday and Sunday side by side: the coming weekend from Monday to Friday, this one on
  Saturday, and on Sunday Sunday and Monday. With the evening switch on, from 18:00 it
  counts from tomorrow: on Saturday evening Sunday and Monday, on Sunday evening the next
  weekend. A day beyond the forecast gets a note. With neither day in it, the next two
  forecast days from `start` instead (today and tomorrow, or tomorrow and the day after in
  the evening), under a one-line note (`wk_note`). Sets `pair`, `weekend` and `two`, like
  views/today_tomorrow.
{%- endcomment -%}
{%- assign wk_noon = days.first | append: "T12:00:00Z" -%}
{%- if evening_switch and now_hour >= 18 -%}
  {%- assign wk_noon = wk_noon | date: "%s" | plus: 86400 | date: "%Y-%m-%dT12:00:00Z" -%}
{%- endif -%}
{%- assign wk_wd = wk_noon | date: "%w" | plus: 0 -%}
{%- if wk_wd == 0 -%}{%- assign wk_ahead = 0 -%}{%- else -%}{%- assign wk_ahead = 6 | minus: wk_wd -%}{%- endif -%}
{%- assign wk_e = wk_noon | date: "%s" | plus: 0 -%}
{%- assign wk_e = wk_ahead | times: 86400 | plus: wk_e -%}
{%- assign wk_first = wk_e | date: "%Y-%m-%d" -%}
{%- assign wk_e = wk_e | plus: 86400 -%}
{%- assign wk_second = wk_e | date: "%Y-%m-%d" -%}
{%- assign pair = wk_first | append: "," | append: wk_second | split: "," -%}
{%- assign weekend = true -%}{%- assign two = true -%}
{%- unless days contains wk_first -%}
{%- assign pair = "" -%}
{%- for d in days offset: start limit: 2 -%}{%- assign pair = pair | append: d | append: "," -%}{%- endfor -%}
{%- assign pair = pair | split: "," -%}
{%- assign wk_note = true -%}
{%- endunless -%}
