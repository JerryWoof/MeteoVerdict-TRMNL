{%- comment -%}
  The next 24 hours: now (and how it feels in the wind), when it rains, the best two
  hours to be outside, and an hourly strip (every 3 hours) over the temperature curve
  with rain bars, night hatched and a line at midnight.
{%- endcomment -%}
{%- comment -%} s: the hour that is running now; the window is s..s+24 (as far as the data goes) {%- endcomment -%}
{%- assign s = 0 -%}
{%- for t in H.time -%}{%- assign e = t | date: "%s" | plus: 0 -%}{%- if e <= now_utc -%}{%- assign s = forloop.index0 -%}{%- else -%}{%- break -%}{%- endif -%}{%- endfor -%}
{%- assign cap = n_hours | minus: 1 -%}
{%- assign last = s | plus: 24 | at_most: cap -%}
{%- assign s1 = s | plus: 1 -%}
{%- assign w_lo = 99 -%}{%- assign w_hi = -99 -%}{%- assign w_rain = 0 -%}{%- assign w_sun = 0 -%}{%- assign w_wind = 0 -%}
{%- assign first_wet = -1 -%}{%- assign first_dry = -1 -%}
{%- for i in (s..last) -%}
  {%- assign v = H.temperature_2m[i] -%}
  {%- if v != nil -%}
    {%- if v < w_lo -%}{%- assign w_lo = v -%}{%- endif -%}
    {%- if v > w_hi -%}{%- assign w_hi = v -%}{%- endif -%}
  {%- endif -%}
  {%- if i == s -%}{%- continue -%}{%- endif -%}
  {%- comment -%} the value at hour i fell in the hour before it {%- endcomment -%}
  {%- assign p = H.precipitation[i] | default: 0 -%}
  {%- assign w_rain = w_rain | plus: p -%}
  {%- assign w_sun = w_sun | plus: H.sunshine_duration[i] -%}
  {%- assign wv = H.wind_speed_10m[i] | default: 0 -%}
  {%- if wv > w_wind -%}{%- assign w_wind = wv -%}{%- endif -%}
  {%- if p >= 0.1 and first_wet < 0 -%}{%- assign first_wet = i -%}{%- endif -%}
  {%- if p < 0.1 and first_wet >= 0 and first_dry < 0 -%}{%- assign first_dry = i -%}{%- endif -%}
{%- endfor -%}
{%- assign w_hours = last | minus: s -%}
{%- if first_wet < 0 -%}
  {%- assign rain_text = T_dry -%}
  {%- if w_hours < 24 -%}{%- assign rain_text = "" -%}{%- endif -%}
{%- elsif first_wet == s1 -%}
  {%- if first_dry < 0 -%}
    {%- assign rain_text = T_rain_all -%}
  {%- else -%}
    {%- assign e = H.time[first_dry] | date: "%s" | minus: 3600 -%}{% include "partials/local" %}
    {%- assign rain_text = le | date: "%H:%M" | prepend: " " | prepend: T_rain_until -%}
  {%- endif -%}
{%- else -%}
  {%- assign e = H.time[first_wet] | date: "%s" | minus: 3600 -%}{% include "partials/local" %}
  {%- assign rain_text = le | date: "%H:%M" | prepend: " " | prepend: T_rain_from -%}
{%- endif -%}

{%- comment -%}
  Feels like: the wind chill (Environment Canada) at 10 °C or below with wind over
  4.8 km/h. Liquid has no powers, so v^0.16 is interpolated between known points.
{%- endcomment -%}
{%- assign now_t = H.temperature_2m[s] -%}
{%- assign feels = nil -%}
{%- if now_t != nil and now_t <= 10 -%}
  {%- assign kmh = H.wind_speed_10m[s] | default: 0 | times: 3.6 -%}
  {%- if kmh > 4.8 -%}
    {%- if kmh < 10 -%}{%- assign f = kmh | minus: 5 | times: 0.03034 | plus: 1.2937 -%}
    {%- elsif kmh < 20 -%}{%- assign f = kmh | minus: 10 | times: 0.017 | plus: 1.4454 -%}
    {%- elsif kmh < 40 -%}{%- assign f = kmh | minus: 20 | times: 0.009470 | plus: 1.6154 -%}
    {%- else -%}{%- assign f = kmh | minus: 40 | times: 0.006035 | plus: 1.8048 | at_most: 2.1 -%}{%- endif -%}
    {%- assign wc = now_t | times: 0.3965 | times: f -%}
    {%- assign wc = f | times: -11.37 | plus: wc | plus: 13.12 -%}
    {%- assign wc = now_t | times: 0.6215 | plus: wc | round -%}
    {%- assign now_r = now_t | round -%}
    {%- if wc < now_r -%}{%- assign feels = wc -%}{%- endif -%}
  {%- endif -%}
{%- endif -%}

{%- comment -%}
  Best two hours outside: daylight, under 0.2 mm of rain, scored by sunshine, by how
  close the temperature is to 21 °C and by little wind.
{%- endcomment -%}
{%- assign best = -1 -%}{%- assign best_score = -999 -%}
{%- assign k_last = last | minus: 2 -%}
{%- if k_last >= s -%}
{%- for k in (s..k_last) -%}
  {%- assign k1 = k | plus: 1 -%}{%- assign k2 = k | plus: 2 -%}
  {%- assign i = k -%}{% include "partials/hour_symbol" %}{%- assign dark = night -%}
  {%- assign i = k1 -%}{% include "partials/hour_symbol" %}
  {%- if dark or night -%}{%- continue -%}{%- endif -%}
  {%- assign br = H.precipitation[k1] | default: 0 | plus: H.precipitation[k2] -%}
  {%- if br >= 0.2 -%}{%- continue -%}{%- endif -%}
  {%- assign ta = H.temperature_2m[k] -%}{%- assign tb = H.temperature_2m[k1] -%}
  {%- if ta == nil or tb == nil -%}{%- continue -%}{%- endif -%}
  {%- assign bs = H.sunshine_duration[k1] | default: 0 | plus: H.sunshine_duration[k2] | divided_by: 3600.0 -%}
  {%- assign bt = ta | plus: tb | divided_by: 2.0 | minus: 21 | abs -%}
  {%- assign bw = H.wind_speed_10m[k1] | default: 0 -%}
  {%- assign score = bs | times: 3 -%}
  {%- assign score = bt | times: -0.15 | plus: score -%}
  {%- assign score = bw | times: -0.1 | plus: score -%}
  {%- if score > best_score -%}{%- assign best_score = score -%}{%- assign best = k -%}{%- endif -%}
{%- endfor -%}
{%- endif -%}
{%- if best >= 0 -%}
  {%- assign e = H.time[best] | date: "%s" | plus: 0 -%}{% include "partials/local" %}{%- assign b_from = le | date: "%H" -%}{%- assign b_day = le | date: "%Y-%m-%d" -%}
  {%- assign e = e | plus: 7200 -%}{% include "partials/local" %}{%- assign b_to = le | date: "%H" -%}
{%- endif -%}

{%- comment -%} today (alerts, next sunrise and sunset) and tomorrow {%- endcomment -%}
{%- assign day = days[0] -%}{% include "partials/day" %}{% include "partials/alerts" %}
{%- assign t_rise = rise -%}{%- assign t_set = set -%}{%- assign t_rise_min = rise_min -%}{%- assign t_set_min = set_min -%}{%- assign today_long = day_long -%}
{%- assign day = days[1] -%}{% include "partials/day" %}
{%- assign now_min = now_local | date: "%H" | times: 60 -%}{%- assign now_min = now_local | date: "%M" | plus: now_min -%}
{%- assign sun_a = "" -%}{%- assign sun_b = "" -%}
{%- if t_rise -%}
  {%- if now_min < t_rise_min -%}{%- assign sun_a = rise_svg | append: " " | append: t_rise -%}{%- assign sun_b = set_svg | append: " " | append: t_set -%}
  {%- elsif now_min < t_set_min -%}{%- assign sun_a = set_svg | append: " " | append: t_set -%}{%- if rise -%}{%- assign sun_b = rise_svg | append: " " | append: rise -%}{%- endif -%}
  {%- elsif rise -%}{%- assign sun_a = rise_svg | append: " " | append: rise -%}{%- assign sun_b = set_svg | append: " " | append: set -%}{%- endif -%}
{%- endif -%}

<style>
  .mv-24 { display: flex; flex-direction: column; gap: 8px; }
  .mv-24 .body { flex: 1; display: flex; gap: 18px; min-height: 0; }
  .mv-24 .now { width: 236px; flex: none; display: flex; flex-direction: column; gap: 5px; }
  .mv-24 .mv-now-l { font-size: 13px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; }
  .mv-24 .hero { display: flex; align-items: center; gap: 4px; }
  .mv-24 .hero svg { width: 88px; height: 88px; flex: none; }
  .mv-24 .mv-max { font-size: 80px; }
  .mv-24 .range { font-size: 18px; font-weight: 700; }
  .mv-24 .say { border: 2px solid #000; border-radius: 8px; padding: 5px 10px; font-size: 18px; font-weight: 800; line-height: 1.2; }
  .mv-24 .say small { display: block; font-size: 14px; font-weight: 600; margin-top: 2px; }
  .mv-24 .mv-kv { display: grid; grid-template-columns: auto 1fr; column-gap: 10px; font-size: 16px; line-height: 1.45; }
  .mv-24 .mv-kv b { font-weight: 800; }
  .mv-24 .mv-sun { font-size: 17px; display: flex; gap: 16px; }
  .mv-24 .mv-tmrw { margin-top: auto; display: flex; align-items: center; gap: 8px; border-top: 2px solid #000; padding-top: 4px; font-size: 19px; }
  .mv-24 .mv-tmrw .w { font-size: 14px; font-weight: 800; letter-spacing: 1px; text-transform: uppercase; }
  .mv-24 .mv-tmrw svg { width: 40px; height: 40px; }
  .mv-24 .mv-tmrw b { font-weight: 800; }
  .mv-24 .strip { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .mv-24 .cells { display: grid; grid-template-columns: repeat(8, 1fr); text-align: center; }
  .mv-24 .cells .h { font-size: 15px; font-weight: 700; }
  .mv-24 .cells svg { width: 44px; height: 44px; display: block; margin: 0 auto; }
  .mv-24 .cells .t { font-size: 20px; font-weight: 800; line-height: 1; }
  .mv-24 .cells .r { font-size: 13px; font-weight: 600; min-height: 16px; }
  .mv-24 .graph { flex: 1; width: 100%; }
</style>
<div class="mv mv-24">
  <div class="mv-head"><span class="when">{{ T_next24 }}</span><span class="date">{{ today_long }}</span></div>
  <div class="body">
    <div class="now">
      <div class="mv-now-l">{{ T_now }} · {{ now_local | date: "%H:%M" }}</div>
      <div class="hero">
        {%- assign i = s1 | at_most: cap -%}{% include "partials/hour_symbol" %}{%- assign icon_class = "" -%}
        {% include "partials/icon" %}
        <span class="mv-max">{% if now_t != nil %}{{ now_t | round }}°{% else %}–{% endif %}</span>
      </div>
      <div class="range">{% if feels != nil %}{{ T_feels }} {{ feels }}° · {% endif %}{% if w_hi > -99 %}{{ T_high }} {{ w_hi | round }}° · {{ T_low }} {{ w_lo | round }}°{% endif %}</div>
      {%- if rain_text != "" -%}
      <div class="say">{{ rain_text }}{% if w_rain >= 0.1 %}<small>{{ w_rain | round: 1 | replace: ".", T_dec }} mm</small>{% endif %}</div>
      {%- endif -%}
      {%- if alerts != "" -%}<div>{{ alerts }}</div>{%- endif -%}
      <div class="mv-kv">
        {%- if best >= 0 -%}<span>{{ T_outside }}</span><b>{% if b_day != real_today %}{{ T_tomorrow | downcase }} {% endif %}{{ b_from }}–{{ b_to }} h</b>{%- endif -%}
        <span>{{ T_sunshine }}</span><b>{%- assign n = w_sun | divided_by: 3600.0 -%}{% include "partials/dec1" %} h</b>
        <span>{{ T_wind }}</span><b>{{ w_wind | times: wind_k | round }} {{ wind_unit }}</b>
      </div>
      {%- if sun_a != "" -%}<div class="mv-sun"><span>{{ sun_a }}</span><span>{{ sun_b }}</span></div>{%- endif -%}
      {%- if days.size > 1 -%}
      <div class="mv-tmrw">
        <span class="w">{{ T_tomorrow }}</span>
        {%- assign icon = sym -%}{%- assign night = false -%}{%- assign icon_class = "" -%}
        {% include "partials/icon" %}
        <span><b>{{ tmax | round }}°</b> / {{ tmin | round }}°</span>
      </div>
      {%- endif -%}
    </div>
    <div class="strip">
      <div class="cells">
        {%- comment -%} cell j: the hours s+3j to s+3j+3, labelled and with the temperature of its middle hour {%- endcomment -%}
        {%- for j in (0..7) -%}
          {%- assign i = j | times: 3 | plus: s1 -%}
          {%- if i > cap -%}<div></div>{%- continue -%}{%- endif -%}
          {%- assign i2 = i | plus: 1 -%}{%- assign i3 = i | plus: 2 -%}
          {%- assign cell_rain = H.precipitation[i] | default: 0 | plus: H.precipitation[i2] | plus: H.precipitation[i3] -%}
          {%- assign e = H.time[i] | date: "%s" | plus: 0 -%}{% include "partials/local" %}
          {%- assign ch = le | date: "%H" | plus: 0 -%}
          {%- assign ct = H.temperature_2m[i] -%}
          <div>
            <div class="h">{% if ch < 3 %}{%- assign cwd = le | date: "%w" | plus: 0 -%}{{ T_days_short[cwd] }} {% endif %}{{ le | date: "%H" }}</div>
            {%- assign i = i2 | at_most: cap -%}{% include "partials/hour_symbol" %}{%- assign icon_class = "" -%}
            {% include "partials/icon" %}
            <div class="t">{% if ct != nil %}{{ ct | round }}°{% else %}–{% endif %}</div>
            <div class="r">{% if cell_rain >= 0.1 %}{{ cell_rain | round: 1 | replace: ".", T_dec }} mm{% endif %}</div>
          </div>
        {%- endfor -%}
      </div>
      {%- comment -%} 10 units per hour from the start of hour s; temperatures in y 6-60, rain bars from 100 up to 33 (3 mm) {%- endcomment -%}
      {%- assign w_range = w_hi | minus: w_lo -%}
      {%- assign w_span = w_range | at_least: 4 -%}
      {%- assign w_top = w_span | minus: w_range | divided_by: 2.0 | plus: w_hi -%}
      {%- assign pts = "" -%}{%- assign bars = "" -%}{%- assign shade = "" -%}{%- assign marks = "" -%}
      {%- for j in (0..24) -%}
        {%- assign i = s | plus: j -%}
        {%- if i > cap -%}{%- break -%}{%- endif -%}
        {%- assign x = j | times: 10 -%}
        {%- assign v = H.temperature_2m[i] -%}
        {%- if v != nil -%}
          {%- assign y = w_top | minus: v | times: 54.0 | divided_by: w_span | plus: 6 | round: 1 -%}
          {%- capture pt -%}{{ x }},{{ y }}{%- endcapture -%}
          {%- assign pts = pts | append: " " | append: pt -%}
        {%- endif -%}
        {%- if j == 24 -%}{%- break -%}{%- endif -%}
        {%- assign i1 = i | plus: 1 -%}
        {%- assign p = H.precipitation[i1] | default: 0 -%}
        {%- if p >= 0.1 -%}
          {%- assign bh = p | at_most: 3 | times: 11 | plus: 1.5 | round: 1 -%}
          {%- capture bar -%}<rect x="{{ x | plus: 1.5 }}" y="{{ 100 | minus: bh }}" width="7" height="{{ bh }}"/>{%- endcapture -%}
          {%- assign bars = bars | append: bar -%}
        {%- endif -%}
        {%- comment -%} night: the part of this hour before sunrise or after sunset; a line at midnight {%- endcomment -%}
        {%- assign e = H.time[i] | date: "%s" | plus: 0 -%}{% include "partials/local" %}
        {%- assign hday = le | date: "%Y-%m-%d" -%}
        {%- assign m0 = le | date: "%H" | times: 60 -%}
        {%- if m0 == 0 and j > 0 -%}
          {%- capture mark -%}<path d="M{{ x }} 0V100" stroke="#000" stroke-width="2" vector-effect="non-scaling-stroke"/>{%- endcapture -%}
          {%- assign marks = marks | append: mark -%}
        {%- endif -%}
        {%- assign hrow = forecast.parts | where: "day", hday | first -%}
        {%- if hrow.sunrise -%}
          {%- assign r_min = hrow.sunrise | slice: 0, 2 | times: 60 -%}{%- assign r_min = hrow.sunrise | slice: 3, 2 | plus: r_min -%}
          {%- assign s_min = hrow.sunset | slice: 0, 2 | times: 60 -%}{%- assign s_min = hrow.sunset | slice: 3, 2 | plus: s_min -%}
          {%- assign m1 = m0 | plus: 60 -%}
          {%- assign a = r_min | at_most: m1 | minus: m0 | at_least: 0 -%}
          {%- if a > 0 -%}
            {%- capture n -%}<rect x="{{ x }}" y="0" width="{{ a | divided_by: 6.0 | round: 2 }}" height="100"/>{%- endcapture -%}{%- assign shade = shade | append: n -%}
          {%- endif -%}
          {%- assign b0 = s_min | at_least: m0 -%}{%- assign b = m1 | minus: b0 | at_least: 0 -%}
          {%- if b > 0 -%}
            {%- capture n -%}<rect x="{{ b0 | minus: m0 | divided_by: 6.0 | plus: x | round: 2 }}" y="0" width="{{ b | divided_by: 6.0 | round: 2 }}" height="100"/>{%- endcapture -%}{%- assign shade = shade | append: n -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
      <svg class="mv-chart graph" viewBox="0 0 240 102" preserveAspectRatio="none">
        <g fill="url(#mv-night)">{{ shade }}</g>
        <path d="M30 0V100M60 0V100M90 0V100M120 0V100M150 0V100M180 0V100M210 0V100" stroke="#000" stroke-width="1" stroke-dasharray="2 3" vector-effect="non-scaling-stroke"/>
        {{ marks }}
        <g fill="#000" stroke="#fff" stroke-width=".8">{{ bars }}</g>
        <polyline points="{{ pts | strip }}" fill="none" stroke="#fff" stroke-width="8" stroke-linejoin="round" vector-effect="non-scaling-stroke"/>
        <polyline points="{{ pts | strip }}" fill="none" stroke="#000" stroke-width="3.5" stroke-linejoin="round" vector-effect="non-scaling-stroke"/>
        <path d="M0 100.5H240" stroke="#000" stroke-width="2" vector-effect="non-scaling-stroke"/>
      </svg>
    </div>
  </div>
</div>
