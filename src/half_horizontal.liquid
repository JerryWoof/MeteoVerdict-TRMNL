{%- comment -%}
  MeteoVerdict for TRMNL: half screen, wide (800x240, for mashups): today in detail and
  the next four days. https://github.com/JerryWoof/MeteoVerdict-TRMNL
{%- endcomment -%}
{% include "shared" %}
<style>
  .mv-hh { display: flex; gap: 14px; align-items: stretch; }
  .mv-hh .today { width: 330px; flex: none; display: flex; flex-direction: column; gap: 4px; }
  .mv-hh .mv-head { padding: 2px 10px; }
  .mv-hh .mv-head .when { font-size: 17px; }
  .mv-hh .mv-head .date { font-size: 14px; }
  .mv-hh .hero { display: flex; align-items: center; gap: 6px; }
  .mv-hh .hero svg { width: 74px; height: 74px; flex: none; }
  .mv-hh .mv-max { font-size: 60px; }
  .mv-hh .side { margin-left: auto; text-align: right; font-size: 15px; line-height: 1.35; }
  .mv-hh .side b { font-size: 16px; font-weight: 800; }
  .mv-hh .line { font-size: 15px; display: flex; justify-content: space-between; }
  .mv-hh .line b { font-weight: 800; }
  .mv-hh .mv-glyph { width: 17px; height: 17px; vertical-align: -3px; }
  .mv-hh .next { flex: 1; display: grid; grid-template-columns: repeat(4, 1fr); border-left: 2px solid #000; }
  .mv-hh .card { text-align: center; }
  .mv-hh .card + .card { border-left: 1px solid #000; }
  .mv-hh .card .d { font-size: 14px; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; }
  .mv-hh .card svg { width: 50px; height: 50px; display: block; margin: 0 auto; }
  .mv-hh .card .hi { font-size: 26px; font-weight: 800; line-height: 1; }
  .mv-hh .card .lo { font-size: 16px; font-weight: 600; }
  .mv-hh .card .r { font-size: 13px; }
</style>
<div class="view view--half_horizontal">
  <div class="layout">
    <div class="mv mv-hh">
      {%- assign day = days[0] -%}{% include "partials/day" %}
      <div class="today">
        <div class="mv-head"><span class="when">{{ T_today }}</span><span class="date">{{ day_long }}</span></div>
        <div class="hero">
          {%- assign icon = sym -%}{%- assign night = false -%}{%- assign icon_class = "" -%}
          {% include "partials/icon" %}
          <span class="mv-max">{{ tmax | round }}°</span>
          <div class="side"><b>{% include "partials/word" %}</b><br>{{ T_low }} {{ tmin | round }}°<br>{{ T_wind }} {{ wind | round }} m/s</div>
        </div>
        <div class="line">
          <span>{{ drop_glyph }} <b>{{ rain | round: 1 | replace: ".", T_dec }} mm</b> {{ chance | times: 100 | round }} %</span>
          {%- if shine != nil -%}<span>{{ sun_glyph }} <b>{{ shine | round: 1 | replace: ".", T_dec }} h</b></span>{%- endif -%}
          {%- if rise -%}<span>{{ rise_svg }}{{ rise }} {{ set_svg }}{{ set }}</span>{%- endif -%}
        </div>
      </div>
      <div class="next">
        {%- for day in days offset: 1 limit: 4 -%}
          {% include "partials/day" %}
          <div class="card">
            <div class="d">{% if forloop.first %}{{ T_tomorrow }}{% else %}{{ day_short }}{% endif %}</div>
            {%- assign icon = sym -%}{%- assign night = false -%}{%- assign icon_class = "" -%}
            {% include "partials/icon" %}
            <div class="hi">{{ tmax | round }}°</div>
            <div class="lo">{{ tmin | round }}°</div>
            <div class="r">{% if rain >= 0.1 %}{{ rain | round: 1 | replace: ".", T_dec }} mm{% else %}&nbsp;{% endif %}</div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
  {%- assign compact = false -%}
  {% include "partials/title_bar" %}
</div>
