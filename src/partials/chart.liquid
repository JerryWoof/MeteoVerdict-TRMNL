{%- comment -%}
  Hourly temperature curve over `chart_days` (Czech days), drawn at its real size,
  `chart_w` × `chart_h` px, so the night's dot screen and the lines land on whole pixels
  of the e-ink panel: night as a light dot screen from sunset to sunrise, rain bars (mm in
  the hour before the value's time, full height at 3 mm) in the bottom 40 %, a dashed line
  at the current time, and no line at midnight. `chart_axis`: hour ticks and labels
  06 12 18 under every day. `chart_labels`: the curve's highest and lowest value written on it.
  Inside, x runs 240 units per day (`k` px per unit).
{%- endcomment -%}
{%- assign cw = chart_days.size | times: 240 -%}
{%- assign k = chart_w | times: 1.0 | divided_by: cw -%}
{%- assign base = chart_days.first | append: "T00:00:00Z" | date: "%s" | plus: 0 -%}
{%- if chart_axis -%}{%- assign floor_y = chart_h | minus: 16 -%}{%- else -%}{%- assign floor_y = chart_h | minus: 2 -%}{%- endif -%}
{%- if chart_labels -%}{%- assign top_y = 20 -%}{%- else -%}{%- assign top_y = 6 -%}{%- endif -%}
{%- assign plot_h = floor_y | minus: top_y -%}
{%- assign curve_h = plot_h | times: 0.62 -%}
{%- assign rain_h = plot_h | times: 0.4 -%}
{%- assign c_lo = 99 -%}{%- assign c_hi = -99 -%}{%- assign x_lo = 0 -%}{%- assign x_hi = 0 -%}
{%- for t in HS.time -%}
  {%- assign e = t | date: "%s" | plus: 0 -%}{% include "partials/local" %}
  {%- assign x = le | minus: base | divided_by: 360.0 -%}
  {%- if x < 0 or x > cw -%}{%- continue -%}{%- endif -%}
  {%- assign v = H.temperature_2m[forloop.index0] -%}
  {%- if v != nil -%}
    {%- if v < c_lo -%}{%- assign c_lo = v -%}{%- assign x_lo = x -%}{%- endif -%}
    {%- if v > c_hi -%}{%- assign c_hi = v -%}{%- assign x_hi = x -%}{%- endif -%}
  {%- endif -%}
{%- endfor -%}
{%- comment -%} a range under 4° is drawn as 4°, centred, so a flat day sits in the middle {%- endcomment -%}
{%- assign c_range = c_hi | minus: c_lo -%}
{%- assign c_span = c_range | at_least: 4 -%}
{%- assign c_top = c_span | minus: c_range | divided_by: 2.0 | plus: c_hi -%}
{%- assign pts = "" -%}{%- assign bars = "" -%}
{%- assign bar_w = chart_w | divided_by: chart_days.size | divided_by: 24.0 | minus: 1 | at_least: 1 | round: 1 -%}
{%- for t in HS.time -%}
  {%- assign e = t | date: "%s" | plus: 0 -%}{% include "partials/local" %}
  {%- assign x = le | minus: base | divided_by: 360.0 -%}
  {%- comment -%} a sample at x = 0 is the rain of the day before's last hour: its bar belongs there, not here {%- endcomment -%}
  {%- if x < 0 or x > cw -%}{%- continue -%}{%- endif -%}
  {%- assign i = forloop.index0 -%}
  {%- assign v = H.temperature_2m[i] -%}
  {%- if v != nil -%}
    {%- assign y = c_top | minus: v | times: curve_h | divided_by: c_span | plus: top_y | round: 1 -%}
    {%- assign px = x | times: k | round: 1 -%}
    {%- comment -%} the first value held level back to the left edge (today starts at 01:00 or 02:00) {%- endcomment -%}
    {%- if pts == "" and px > 0 -%}{%- capture pt -%}0,{{ y }}{%- endcapture -%}{%- assign pts = pt -%}{%- endif -%}
    {%- capture pt -%}{{ px }},{{ y }}{%- endcapture -%}
    {%- assign pts = pts | append: " " | append: pt -%}
    {%- assign last_y = y -%}{%- assign last_px = px -%}
  {%- endif -%}
  {%- assign p = H.precipitation[i] | default: 0 -%}
  {%- if p >= 0.1 and x > 0 -%}
    {%- assign bh = p | at_most: 3 | divided_by: 3.0 | times: rain_h | plus: 2 | round -%}
    {%- assign bx = x | minus: 10 | times: k | plus: 0.5 | round -%}
    {%- capture bar -%}<rect x="{{ bx }}" y="{{ floor_y | minus: bh }}" width="{{ bar_w }}" height="{{ bh }}"/>{%- endcapture -%}
    {%- assign bars = bars | append: bar -%}
  {%- endif -%}
{%- endfor -%}
{%- comment -%} and the last held level to the right edge, where the forecast ends before it {%- endcomment -%}
{%- if pts != "" and last_px < chart_w -%}{%- capture pt -%}{{ chart_w }},{{ last_y }}{%- endcapture -%}{%- assign pts = pts | append: " " | append: pt -%}{%- endif -%}
<svg class="mv-chart {{ chart_class }}" width="{{ chart_w }}" height="{{ chart_h }}" viewBox="0 0 {{ chart_w }} {{ chart_h }}">
  {%- for cd in chart_days -%}
    {%- assign x0 = forloop.index0 | times: 240 -%}
    {%- assign crow = forecast.parts | where: "day", cd | first -%}
    {%- if crow.sunrise -%}
      {%- assign r_min = crow.sunrise | slice: 0, 2 | times: 60 -%}{%- assign r_min = crow.sunrise | slice: 3, 2 | plus: r_min -%}
      {%- assign s_min = crow.sunset | slice: 0, 2 | times: 60 -%}{%- assign s_min = crow.sunset | slice: 3, 2 | plus: s_min -%}
      {%- assign nx0 = x0 | times: k | round -%}{%- assign nx1 = r_min | divided_by: 6.0 | plus: x0 | times: k | round -%}
      {%- assign nx2 = s_min | divided_by: 6.0 | plus: x0 | times: k | round -%}{%- assign nx3 = x0 | plus: 240 | times: k | round -%}
      <rect x="{{ nx0 }}" y="0" width="{{ nx1 | minus: nx0 }}" height="{{ floor_y }}" fill="url(#mv-night)"/>
      <rect x="{{ nx2 }}" y="0" width="{{ nx3 | minus: nx2 }}" height="{{ floor_y }}" fill="url(#mv-night)"/>
    {%- endif -%}
    {%- if chart_axis or chart_days.size == 1 -%}
      {%- for hh in (1..3) -%}
        {%- assign gx = hh | times: 60 | plus: x0 | times: k | round | plus: 0.5 -%}
        <path d="M{{ gx }} {{ floor_y | minus: 5 }}V{{ floor_y }}" stroke="#000" stroke-width="1"/>
        {%- if chart_axis -%}<text x="{{ gx }}" y="{{ chart_h | minus: 2 }}" text-anchor="middle" class="mv-tick">{{ hh | times: 6 | prepend: "0" | slice: -2, 2 }}</text>{%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endfor -%}
  <g fill="#000" shape-rendering="crispEdges">{{ bars }}</g>
  <polyline points="{{ pts | strip }}" fill="none" stroke="#fff" stroke-width="8" stroke-linejoin="round" stroke-linecap="round"/>
  <polyline points="{{ pts | strip }}" fill="none" stroke="#000" stroke-width="3.5" stroke-linejoin="round" stroke-linecap="round"/>
  {%- if chart_labels and c_hi > -99 -%}
    {%- assign lx_max = chart_w | minus: 16 -%}{%- assign lx = x_hi | times: k | at_least: 16 | at_most: lx_max | round -%}
    {%- assign ly = c_top | minus: c_hi | times: curve_h | divided_by: c_span | plus: top_y | minus: 7 | round -%}
    <text x="{{ lx }}" y="{{ ly }}" text-anchor="middle" class="mv-lab">{{ c_hi | round }}°</text>
    {%- assign lx = x_lo | times: k | at_least: 16 | at_most: lx_max | round -%}
    {%- assign ly = c_top | minus: c_lo | times: curve_h | divided_by: c_span | plus: top_y | plus: 20 | round -%}
    <text x="{{ lx }}" y="{{ ly }}" text-anchor="middle" class="mv-lab">{{ c_lo | round }}°</text>
  {%- endif -%}
  {%- assign now_x = now_local | minus: base | divided_by: 360.0 -%}
  {%- if now_x >= 0 and now_x < cw -%}
    <path d="M{{ now_x | times: k | round | plus: 0.5 }} 0V{{ floor_y }}" stroke="#000" stroke-width="2" stroke-dasharray="4 3"/>
  {%- endif -%}
  <path d="M0 {{ floor_y | plus: 1 }}H{{ chart_w }}" stroke="#000" stroke-width="2" shape-rendering="crispEdges"/>
</svg>
