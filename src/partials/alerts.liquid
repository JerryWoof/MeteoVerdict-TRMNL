{%- comment -%}
  `alerts`: up to two badges for the day just read by partials/day: black ice (an hour at
  or below 0.5 °C with precipitation), frost (MeteoVerdict's corrected night minimum: air
  frost, else ground frost at 5 cm; older data without those fields: low at or below 0 °C),
  heavy rain (10 mm or more), strong wind (10 m/s or more, hourly mean), heat (30 °C or more).
{%- endcomment -%}
{%- assign alerts = "" -%}{%- assign n_alerts = 0 -%}
{%- assign ice = false -%}
{%- if day and tmin <= 1 -%}
  {%- for t in H.time -%}
    {%- assign e = t | date: "%s" | plus: 0 -%}{% include "partials/local" %}
    {%- assign hd = le | date: "%Y-%m-%d" -%}
    {%- if hd != day -%}{%- continue -%}{%- endif -%}
    {%- assign ht = H.temperature_2m[forloop.index0] -%}{%- assign hp = H.precipitation[forloop.index0] | default: 0 -%}
    {%- if ht != nil and ht <= 0.5 and hp >= 0.1 -%}{%- assign ice = true -%}{%- break -%}{%- endif -%}
  {%- endfor -%}
{%- endif -%}
{%- if ice -%}
  {%- capture a -%}<span class="mv-badge">{{ T_ice }}</span>{%- endcapture -%}{%- assign alerts = alerts | append: a -%}{%- assign n_alerts = n_alerts | plus: 1 -%}
{%- else -%}
  {%- comment -%} the night ending this morning carries the frost fields {%- endcomment -%}
  {%- assign night = rows | where: "part", "night" | first -%}
  {%- if night.frost == true -%}
    {%- capture a -%}<span class="mv-badge">{{ T_frost }} {{ night.night_min | round }}°</span>{%- endcapture -%}{%- assign alerts = alerts | append: a -%}{%- assign n_alerts = n_alerts | plus: 1 -%}
  {%- elsif night.ground_frost == true -%}
    {%- capture a -%}<span class="mv-badge">{{ T_ground_frost }}</span>{%- endcapture -%}{%- assign alerts = alerts | append: a -%}{%- assign n_alerts = n_alerts | plus: 1 -%}
  {%- elsif night.frost == nil and rows.size > 0 and tmin <= 0 -%}
    {%- capture a -%}<span class="mv-badge">{{ T_frost }} {{ tmin | round }}°</span>{%- endcapture -%}{%- assign alerts = alerts | append: a -%}{%- assign n_alerts = n_alerts | plus: 1 -%}
  {%- endif -%}
{%- endif -%}
{%- if rows.size > 0 and rain >= 10 -%}
  {%- capture a -%}<span class="mv-badge">{{ T_downpour }}</span>{%- endcapture -%}{%- assign alerts = alerts | append: a -%}{%- assign n_alerts = n_alerts | plus: 1 -%}
{%- endif -%}
{%- if rows.size > 0 and wind >= 10 and n_alerts < 2 -%}
  {%- capture a -%}<span class="mv-badge">{{ T_storm }}</span>{%- endcapture -%}{%- assign alerts = alerts | append: a -%}{%- assign n_alerts = n_alerts | plus: 1 -%}
{%- endif -%}
{%- if rows.size > 0 and tmax >= 30 and n_alerts < 2 -%}
  {%- capture a -%}<span class="mv-badge">{{ T_heat }} {{ tmax | round }}°</span>{%- endcapture -%}{%- assign alerts = alerts | append: a -%}{%- assign n_alerts = n_alerts | plus: 1 -%}
{%- endif -%}
