{%- comment -%}
  `icon` and `night` for hour `i` of the hourly series: precipitation in the hour ending
  at i first (0.5 mm rain, sleet or snow by temperature; 0.1 mm showers), otherwise sky by
  cloud cover (under 25 % clear, under 70 % partly); night between that day's sunset and
  sunrise.
{%- endcomment -%}
{%- assign hp = H.precipitation[i] | default: 0 -%}
{%- assign hc = HS.cloud_cover[i] -%}
{%- assign ht = H.temperature_2m[i] | default: 10 -%}
{%- if hp >= 0.5 -%}
  {%- if ht <= 0.5 -%}{%- assign icon = "snow" -%}{%- elsif ht <= 2 -%}{%- assign icon = "sleet" -%}{%- else -%}{%- assign icon = "rain" -%}{%- endif -%}
{%- elsif hp >= 0.1 -%}{%- assign icon = "showers" -%}
{%- elsif hc == nil -%}{%- assign icon = "" -%}
{%- elsif hc < 25 -%}{%- assign icon = "clear" -%}
{%- elsif hc < 70 -%}{%- assign icon = "partly" -%}
{%- else -%}{%- assign icon = "cloudy" -%}{%- endif -%}
{%- assign night = false -%}
{%- if HS.time[i] -%}
  {%- assign e = HS.time[i] | date: "%s" | plus: 0 -%}{% include "partials/local" %}
  {%- assign hday = le | date: "%Y-%m-%d" -%}
  {%- assign hmin = le | date: "%H" | times: 60 -%}
  {%- assign hrow = forecast.parts | where: "day", hday | first -%}
  {%- if hrow.sunrise -%}
    {%- assign r_min = hrow.sunrise | slice: 0, 2 | times: 60 -%}{%- assign r_min = hrow.sunrise | slice: 3, 2 | plus: r_min -%}
    {%- assign s_min = hrow.sunset | slice: 0, 2 | times: 60 -%}{%- assign s_min = hrow.sunset | slice: 3, 2 | plus: s_min -%}
    {%- if hmin < r_min or hmin >= s_min -%}{%- assign night = true -%}{%- endif -%}
  {%- endif -%}
{%- endif -%}
