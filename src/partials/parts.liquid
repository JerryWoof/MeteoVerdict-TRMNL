{%- comment -%} night, morning, afternoon and evening of `rows`: name, symbol, temperature {%- endcomment -%}
<div class="mv-parts">
  {%- assign part_names = "night,morning,afternoon,evening" | split: "," -%}
  {%- for part in part_names -%}
    {%- assign p = rows | where: "part", part | first -%}
    {%- assign tp = p -%}{%- if orows -%}{%- assign op = orows | where: "part", part | first -%}{%- if op -%}{%- assign tp = op -%}{%- endif -%}{%- endif -%}
    <div class="mv-part">
      <div class="n">{{ T_parts[forloop.index0] }}</div>
      {%- if p -%}
        {%- assign icon = p.symbol -%}{%- assign icon_class = "" -%}
        {%- comment -%} a moon at night, and in the evening when the sun sets before 20:00 {%- endcomment -%}
        {%- assign night = false -%}
        {%- if part == "night" -%}{%- assign night = true -%}{%- endif -%}
        {%- if part == "evening" and set_min != nil and set_min < 1200 -%}{%- assign night = true -%}{%- endif -%}
        {% include "partials/icon" %}
        <div class="t">{% if part == "night" %}{{ tp.tmin | round }}{% else %}{{ tp.tmax | round }}{% endif %}°</div>
      {%- else -%}
        <svg viewBox="0 0 64 64"></svg><div class="t">–</div>
      {%- endif -%}
    </div>
  {%- endfor -%}
</div>
