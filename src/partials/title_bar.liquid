{%- comment -%}
  The footer's time is the Czech clock at render time (the TRMNL poll), so it reads as the
  current time; the forecast's own time is shown only when the forecast is stale.
  The footer: place, which forecast (MeteoVerdict AI or MeteoVerdict, the blend) and when the forecast was made (the time; the date too when it is not from
  today). An old forecast says so.
{%- endcomment -%}
{%- if lang == "cs" -%}
  {%- assign gmo = generated_local | date: "%m" | plus: 0 -%}
  {%- assign gdate = generated_local | date: "%d" | plus: 0 | append: ". " | append: gmo | append: "." -%}
{%- else -%}
  {%- assign gmo = generated_local | date: "%m" | plus: 0 | minus: 1 -%}
  {%- assign gdate = T_months[gmo] | slice: 0, 3 -%}{%- assign gdate = generated_local | date: "%d" | plus: 0 | append: " " | append: gdate -%}
{%- endif -%}
{%- assign gtime = generated_local | date: "%H:%M" -%}
{%- assign gday = generated_local | date: "%Y-%m-%d" -%}
<div class="title_bar">
  <span class="title">{{ place }}</span>
  {%- if stale -%}
  <span class="instance"><span class="mv-badge">{{ T_stale }}</span> {{ T_updated }} {{ gdate }} {{ gtime }}</span>
  {%- else -%}
  {%- if any_alert -%}<span class="mv-note">{{ T_notice }}</span>{%- endif -%}
  <span class="instance">{% if ai %}{{ T_ai }}{% else %}MeteoVerdict{% endif %} · {{ now_local | date: "%H:%M" }}</span>
  {%- endif -%}
</div>
