{%- comment -%}
  MeteoVerdict for TRMNL: full screen (800x480). Pick the view in the plugin's settings:
  today_tomorrow, next_24h, next_48h or five_days. https://github.com/JerryWoof/MeteoVerdict-TRMNL
{%- endcomment -%}
{% include "shared" %}
<div class="layout">
  {%- if days.size == 0 -%}
  <div class="mv"><p class="mv-empty">{{ T_none }} {{ generated_local | date: "%d.%m. %H:%M" }}.</p></div>
  {%- else -%}
  {% include "views/days" %}
  {%- endif -%}
</div>
{% include "partials/title_bar" %}
