{%- comment -%}
  MeteoVerdict for TRMNL: full screen (800x480). Pick the view in the plugin's settings:
  today_tomorrow, next_24h or five_days. https://github.com/JerryWoof/MeteoVerdict-TRMNL
{%- endcomment -%}
{% include "shared" %}
<div class="view view--full">
  <div class="layout">
    {%- case view -%}
    {%- when "next_24h" -%}{% include "views/next_24h" %}
    {%- when "five_days" -%}{% include "views/five_days" %}
    {%- else -%}{% include "views/today_tomorrow" %}
    {%- endcase -%}
  </div>
  {%- assign compact = false -%}
  {% include "partials/title_bar" %}
</div>
