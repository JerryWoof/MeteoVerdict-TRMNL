{%- comment -%}
  MeteoVerdict for TRMNL: full screen (800x480). Pick the view in the plugin's settings:
  today_tomorrow, next_24h, five_days or weekend. https://github.com/JerryWoof/MeteoVerdict-TRMNL
{%- endcomment -%}
{% include "shared" %}
<div class="layout">
  {%- if days.size == 0 -%}
  <div class="mv"><p class="mv-empty">{{ T_none }} {{ generated_local | date: "%d.%m. %H:%M" }}.</p></div>
  {%- else -%}
  {%- assign two = false -%}{%- assign wk_note = false -%}
  {%- case view -%}
  {%- when "next_24h" -%}{% include "views/next_24h" %}
  {%- when "five_days" -%}{% include "views/five_days" %}
  {%- when "weekend" -%}{% include "views/weekend" %}
  {%- else -%}{% include "views/today_tomorrow" %}
  {%- endcase -%}
  {%- if two -%}
    {%- if wk_note -%}<div class="mv mv-wk"><div class="note">{{ T_weekend_later }}</div>{%- endif -%}
    {% include "partials/two_days" %}
    {%- if wk_note -%}</div>{%- endif -%}
  {%- endif -%}
  {%- endif -%}
</div>
{%- assign compact = false -%}
{% include "partials/title_bar" %}
