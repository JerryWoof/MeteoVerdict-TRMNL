{%- comment -%}
  Shared by every layout: settings, labels in English and Czech, today and tomorrow in
  Czech time, the weather symbols and the styles. scripts/build.mjs inlines it (and
  every other include) into the files in dist/, which are what you paste into TRMNL.
{%- endcomment -%}

{%- comment -%}
  One polling URL: an okres file (blend `api/v1/okresy/…` or AI `api/v1/ai/okresy/…`) at the
  top level. Two (private plugins): IDX_0 is the okres file and IDX_1 an obec file
  (`api/v1/obce/…`), whose temperature, rain and wind replace the okres's: `H` (hourly) and
  `OP` (parts) are the obec's then, `HS` (sky: cloud and sunshine) is always the okres's.
{%- endcomment -%}
{%- assign obec = nil -%}{%- assign OP = nil -%}
{%- if IDX_0 -%}
  {%- assign okres = IDX_0.okres -%}{%- assign forecast = IDX_0.forecast -%}{%- assign models = IDX_0.models -%}
  {%- if IDX_1.obec and IDX_1.hourly.temperature_2m.size == IDX_0.forecast.hourly.time.size -%}{%- assign obec = IDX_1.obec -%}{%- assign OP = IDX_1.parts -%}{%- endif -%}
{%- endif -%}
{%- assign ai = false -%}{%- if forecast.model == "ai" -%}{%- assign ai = true -%}{%- endif -%}
{%- assign settings = trmnl.plugin_settings.custom_fields_values -%}
{%- assign lang = settings.language | default: "en" -%}
{%- assign view = settings.view | default: "today_tomorrow" -%}
{%- assign place = settings.place | default: "" | strip -%}
{%- if place == "" and obec -%}{%- assign place = obec.name -%}{%- endif -%}
{%- if place == "" -%}{%- if okres.code == "CZ0100" -%}{%- assign place = "Praha" -%}{%- else -%}{%- assign place = okres.name -%}{%- endif -%}{%- endif -%}
{%- comment -%} after 18:00 the day views move on to tomorrow, unless switched off {%- endcomment -%}
{%- assign evening_switch = true -%}
{%- if settings.evening_switch == false or settings.evening_switch == "false" or settings.evening_switch == "no" -%}{%- assign evening_switch = false -%}{%- endif -%}
{%- if settings.wind_unit == "kmh" -%}{%- assign wind_k = 3.6 -%}{%- assign wind_unit = "km/h" -%}{%- else -%}{%- assign wind_k = 1 -%}{%- assign wind_unit = "m/s" -%}{%- endif -%}

{%- if lang == "cs" -%}
  {%- assign T_today = "Dnes" -%}{%- assign T_tomorrow = "Zítra" -%}
  {%- assign T_next24 = "Příštích 24 hodin" -%}{%- assign T_days5 = "Předpověď na 5 dní" -%}
  {%- assign T_beyond = "# je mimo předpověď" -%}{%- assign T_weekend_later = "Víkend zatím mimo předpověď" -%}
  {%- assign T_rain = "Srážky" -%}{%- assign T_chance = "šance" -%}
  {%- assign T_sunshine = "Slunce" -%}{%- assign T_of = "z" -%}
  {%- assign T_clouds = "Oblačnost" -%}{%- assign T_daytime = "přes den" -%}
  {%- assign T_wind = "Vítr" -%}{%- assign T_max = "nejvíc" -%}
  {%- assign T_parts = "Noc,Ráno,Odpoledne,Večer" | split: "," -%}
  {%- assign T_now = "Teď" -%}{%- assign T_high = "max" -%}{%- assign T_low = "min" -%}
  {%- assign T_feels = "pocitově" -%}
  {%- assign T_dry = "Příštích 24 hodin bez srážek" -%}
  {%- assign T_rain_from = "Srážky od" -%}{%- assign T_rain_until = "Srážky do" -%}{%- assign T_rain_all = "Srážky celý den" -%}
  {%- assign T_outside = "Ven nejlépe" -%}
  {%- assign T_warmer = "o # ° tepleji" -%}{%- assign T_colder = "o # ° chladněji" -%}
  {%- assign T_warmest = "Nejtepleji" -%}{%- assign T_wettest = "Nejvíc srážek" -%}{%- assign T_sunniest = "Nejvíc slunce" -%}
  {%- assign T_frost = "Mráz" -%}{%- assign T_ground_frost = "Přízemní mráz" -%}{%- assign T_heat = "Vedro" -%}
  {%- assign T_storm = "Silný vítr" -%}{%- assign T_gusts = "Nárazy" -%}{%- assign T_downpour = "Vydatně prší" -%}
  {%- assign T_thresholds = "Prahy, ne výstrahy ČHMÚ" -%}{%- assign T_thresholds_short = "nejde o výstrahy ČHMÚ" -%}
  {%- assign T_updated = "aktualizace" -%}{%- assign T_models = "modelů" -%}{%- assign T_ai = "MeteoVerdict AI (exp.)" -%}{%- assign T_obec = "obec (test)" -%}
  {%- assign T_stale = "stará předpověď" -%}{%- assign T_none = "Předpověď na dnešek zatím není. Poslední je z" -%}
  {%- assign T_symbols = "Jasno,Polojasno,Zataženo,Přeháňky,Déšť,Déšť se sněhem,Sněžení" | split: "," -%}
  {%- assign T_days = "neděle,pondělí,úterý,středa,čtvrtek,pátek,sobota" | split: "," -%}
  {%- assign T_days_short = "Ne,Po,Út,St,Čt,Pá,So" | split: "," -%}
  {%- assign T_months = "ledna,února,března,dubna,května,června,července,srpna,září,října,listopadu,prosince" | split: "," -%}
  {%- assign T_dec = "," -%}
{%- else -%}
  {%- assign T_today = "Today" -%}{%- assign T_tomorrow = "Tomorrow" -%}
  {%- assign T_next24 = "Next 24 hours" -%}{%- assign T_days5 = "5-day forecast" -%}
  {%- assign T_beyond = "# is beyond the forecast" -%}{%- assign T_weekend_later = "Weekend not in the forecast yet" -%}
  {%- assign T_rain = "Rain" -%}{%- assign T_chance = "chance" -%}
  {%- assign T_sunshine = "Sunshine" -%}{%- assign T_of = "of" -%}
  {%- assign T_clouds = "Clouds" -%}{%- assign T_daytime = "daytime" -%}
  {%- assign T_wind = "Wind" -%}{%- assign T_max = "max" -%}
  {%- assign T_parts = "Night,Morning,Afternoon,Evening" | split: "," -%}
  {%- assign T_now = "Now" -%}{%- assign T_high = "high" -%}{%- assign T_low = "low" -%}
  {%- assign T_feels = "feels" -%}
  {%- assign T_dry = "Dry for the next 24 hours" -%}
  {%- assign T_rain_from = "Rain from" -%}{%- assign T_rain_until = "Rain until" -%}{%- assign T_rain_all = "Rain all day" -%}
  {%- assign T_outside = "Best outside" -%}
  {%- assign T_warmer = "# ° warmer" -%}{%- assign T_colder = "# ° colder" -%}
  {%- assign T_warmest = "Warmest" -%}{%- assign T_wettest = "Wettest" -%}{%- assign T_sunniest = "Sunniest" -%}
  {%- assign T_frost = "Frost" -%}{%- assign T_ground_frost = "Ground frost" -%}{%- assign T_heat = "Hot" -%}
  {%- assign T_storm = "Strong wind" -%}{%- assign T_gusts = "Gusts" -%}{%- assign T_downpour = "Heavy rain" -%}
  {%- assign T_thresholds = "Thresholds, not ČHMÚ warnings" -%}{%- assign T_thresholds_short = "not ČHMÚ warnings" -%}
  {%- assign T_updated = "updated" -%}{%- assign T_models = "models" -%}{%- assign T_ai = "MeteoVerdict AI (exp.)" -%}{%- assign T_obec = "obec (test)" -%}
  {%- assign T_stale = "old forecast" -%}{%- assign T_none = "No forecast for today yet. The latest is from" -%}
  {%- assign T_symbols = "Sunny,Partly cloudy,Cloudy,Showers,Rain,Sleet,Snow" | split: "," -%}
  {%- assign T_days = "Sunday,Monday,Tuesday,Wednesday,Thursday,Friday,Saturday" | split: "," -%}
  {%- assign T_days_short = "Sun,Mon,Tue,Wed,Thu,Fri,Sat" | split: "," -%}
  {%- assign T_months = "January,February,March,April,May,June,July,August,September,October,November,December" | split: "," -%}
  {%- assign T_dec = "." -%}
{%- endif -%}
{%- assign any_alerts = false -%}
{%- assign SYMBOLS = "clear,partly,cloudy,showers,rain,sleet,snow" | split: "," -%}

{%- comment -%}
  Czech time for every hour: the forecast is for Czechia and its days are Prague days, so
  times follow CET/CEST (summer time from the last Sunday of March to the last Sunday of
  October, 01:00 UTC), whatever the TRMNL account's time zone. partials/local turns a UTC
  epoch `e` into `le`, an epoch that reads as Prague time when formatted as UTC.
{%- endcomment -%}
{%- assign now_utc = "now" | date: "%s" | plus: 0 -%}
{%- assign year = now_utc | date: "%Y" -%}
{%- assign mar31 = year | append: "-03-31T01:00:00Z" -%}{%- assign back = mar31 | date: "%w" | times: 86400 -%}
{%- assign dst_start = mar31 | date: "%s" | minus: back -%}
{%- assign oct31 = year | append: "-10-31T01:00:00Z" -%}{%- assign back = oct31 | date: "%w" | times: 86400 -%}
{%- assign dst_end = oct31 | date: "%s" | minus: back -%}
{%- assign e = now_utc -%}{% include "partials/local" %}{%- assign now_local = le -%}
{%- assign now_hour = now_local | date: "%H" | plus: 0 -%}
{%- assign real_today = now_local | date: "%Y-%m-%d" -%}

{%- comment -%}
  The forecast's days from today on. Clock behind the data: start at its first day. Data
  behind the clock (the forecast stopped updating) and nothing left for today: no days,
  and the layouts say so. `stale`: generated more than 30 hours ago.
{%- endcomment -%}
{%- assign all_days = forecast.parts | map: "day" | uniq -%}
{%- assign today = real_today -%}
{%- if all_days.first > today -%}{%- assign today = all_days.first -%}{%- endif -%}
{%- assign days = "" -%}
{%- for d in all_days -%}{%- if d >= today -%}{%- assign days = days | append: d | append: "," -%}{%- endif -%}{%- endfor -%}
{%- assign days = days | split: "," -%}
{%- assign e = forecast.generated | date: "%s" | plus: 0 -%}{% include "partials/local" %}{%- assign generated_local = le -%}
{%- assign age = now_utc | minus: e -%}
{%- assign stale = false -%}{%- if age > 108000 -%}{%- assign stale = true -%}{%- endif -%}
{%- assign start = 0 -%}{%- if evening_switch and now_hour >= 18 and days.size > 2 -%}{%- assign start = 1 -%}{%- endif -%}
{%- assign HS = forecast.hourly -%}
{%- if obec -%}{%- assign H = IDX_1.hourly -%}{%- else -%}{%- assign H = forecast.hourly -%}{%- endif -%}
{%- assign n_hours = HS.time.size -%}
{%- assign models_used = models.variables.temperature_2m.lead_days["1"].size | default: 0 -%}

{%- comment -%} weather symbols as inline SVG (64x64), black on white for e-ink {%- endcomment -%}
{%- capture sun -%}<g stroke="#000" stroke-width="4" stroke-linecap="round"><circle cx="32" cy="32" r="11"/><path d="M32 6v7M32 51v7M6 32h7M51 32h7M13.6 13.6l5 5M45.4 45.4l5 5M13.6 50.4l5-5M45.4 18.6l5-5"/></g>{%- endcapture -%}
{%- capture moon -%}<path d="M38 8a24 24 0 1 0 18 36A19 19 0 0 1 38 8z"/>{%- endcapture -%}
{%- capture cloud_svg -%}<path d="M18 50H46A9 9 0 0 0 46 32A13 13 0 0 0 21 30A10 10 0 0 0 18 50Z" fill="#fff" stroke="#000" stroke-width="3.5" stroke-linejoin="round"/>{%- endcapture -%}
{%- capture drops -%}<path d="M24 48l-3 8M33 48l-3 8M42 48l-3 8" stroke="#000" stroke-width="3.5" stroke-linecap="round"/>{%- endcapture -%}
{%- capture drop1 -%}<path d="M30 48l-3 8M40 48l-3 8" stroke="#000" stroke-width="3.5" stroke-linecap="round"/>{%- endcapture -%}
{%- capture flakes -%}<g stroke="#000" stroke-width="2.5" stroke-linecap="round"><path d="M22 47v10M17.7 49.5l8.6 5M17.7 54.5l8.6-5M42 47v10M37.7 49.5l8.6 5M37.7 54.5l8.6-5"/></g>{%- endcapture -%}
{%- capture sleet -%}<path d="M24 47l-3 8" stroke="#000" stroke-width="3.5" stroke-linecap="round"/><g stroke="#000" stroke-width="2.5" stroke-linecap="round"><path d="M40 47v10M35.7 49.5l8.6 5M35.7 54.5l8.6-5"/></g>{%- endcapture -%}
{%- capture rise_svg -%}<svg class="mv-glyph" viewBox="0 0 24 24"><path d="M2 19h20M6.5 19a5.5 5.5 0 0 1 11 0M12 3v7M8.5 6.5 12 3l3.5 3.5" fill="none" stroke="#000" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>{%- endcapture -%}
{%- capture sun_glyph -%}<svg class="mv-glyph" viewBox="0 0 24 24"><g stroke="#000" stroke-width="2.4" stroke-linecap="round"><circle cx="12" cy="12" r="4.5" fill="#000"/><path d="M12 1.5v3M12 19.5v3M1.5 12h3M19.5 12h3M4.6 4.6l2.1 2.1M17.3 17.3l2.1 2.1M4.6 19.4l2.1-2.1M17.3 6.7l2.1-2.1"/></g></svg>{%- endcapture -%}
{%- capture drop_glyph -%}<svg class="mv-glyph" viewBox="0 0 24 24"><path d="M12 2.5C9 7.5 6 10.5 6 15a6 6 0 0 0 12 0c0-4.5-3-7.5-6-12.5z" fill="#000"/></svg>{%- endcapture -%}
{%- capture set_svg -%}<svg class="mv-glyph" viewBox="0 0 24 24"><path d="M2 19h20M6.5 19a5.5 5.5 0 0 1 11 0M12 3v7M8.5 6.5 12 10l3.5-3.5" fill="none" stroke="#000" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>{%- endcapture -%}

<style>
  .mv { width: 100%; height: 100%; font-family: "Inter", "Helvetica Neue", Arial, sans-serif; color: #000; }
  .mv svg { overflow: visible; }
  .mv-head { display: flex; justify-content: space-between; align-items: center; background: #000; color: #fff; border-radius: 8px; padding: 3px 12px; white-space: nowrap; }
  .mv-head .when { font-size: 21px; font-weight: 800; letter-spacing: 2px; text-transform: uppercase; }
  .mv-head .date { font-size: 17px; font-weight: 600; }
  .mv-max { font-weight: 800; letter-spacing: -2px; line-height: 1; white-space: nowrap; }
  .mv-pm { font-size: 34%; font-weight: 700; letter-spacing: 0; vertical-align: 95%; margin-left: 2px; }
  .title_bar .mv-note { font-size: 13px; font-weight: 600; margin-left: 10px; }
  .mv-glyph { width: 22px; height: 22px; vertical-align: -5px; }
  .mv-sun { font-weight: 700; white-space: nowrap; }
  .mv-facts { display: grid; grid-template-columns: repeat(4, 1fr); border: 2px solid #000; border-radius: 8px; padding: 3px 0; text-align: center; }
  .mv-fact + .mv-fact { border-left: 1px solid #000; }
  .mv-fact span { display: block; font-size: 11px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; }
  .mv-fact b { display: block; font-size: 20px; font-weight: 800; line-height: 1.15; }
  .mv-fact i { display: block; font-size: 11px; font-style: normal; }
  .mv-chart { display: block; flex: none !important; }
  .mv-tick { font-size: 12px; font-weight: 700; }
  .mv-lab { font-size: 16px; font-weight: 800; paint-order: stroke; stroke: #fff; stroke-width: 5px; stroke-linejoin: round; }
  .mv-badge { display: inline-block; background: #000; color: #fff; border-radius: 4px; padding: 0 5px; font-size: 13px; font-weight: 800; letter-spacing: .5px; text-transform: uppercase; white-space: nowrap; line-height: 1.45; }
  .mv-head .mv-badge { background: #fff; color: #000; margin-left: 8px; vertical-align: 2px; }
  .mv-empty { font-size: 20px; font-weight: 700; padding: 30px 10px; text-align: center; }
  .title_bar .title { flex: 0 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .title_bar .instance { flex: none; margin-left: auto; padding-left: 12px; }
</style>
<svg width="0" height="0" style="position:absolute">
  <defs><pattern id="mv-night" width="3" height="3" patternUnits="userSpaceOnUse"><rect width="1" height="1" fill="#000" shape-rendering="crispEdges"/></pattern></defs>
</svg>
