{%- comment -%}
  MeteoVerdict for TRMNL: half screen, tall (400x480, for mashups): today with its parts of
  day and hourly curve, and tomorrow in a line. https://github.com/JerryWoof/MeteoVerdict-TRMNL
{%- endcomment -%}
{% include "shared" %}
<style>
  .mv-hv { display: flex; flex-direction: column; gap: 6px; }
  .mv-hv .hero { display: flex; align-items: center; gap: 6px; }
  .mv-hv .hero > svg { width: 86px; height: 86px; flex: none; }
  .mv-hv .mv-max { font-size: 68px; }
  .mv-hv .side { margin-left: auto; text-align: right; line-height: 1.3; }
  .mv-hv .what { font-size: 17px; font-weight: 800; }
  .mv-hv .lo { font-size: 18px; font-weight: 600; }
  .mv-hv .mv-sun { font-size: 16px; }
  .mv-hv .mv-facts { grid-template-columns: repeat(4, 1fr); }
  .mv-hv .mv-fact b { font-size: 17px; }
  .mv-hv .mv-fact i { white-space: nowrap; }
  .mv-parts { display: grid; grid-template-columns: repeat(4, 1fr); text-align: center; }
  .mv-part .n { font-size: 11px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; }
  .mv-part svg { width: 36px; height: 36px; display: block; margin: 0 auto; }
  .mv-part .t { font-size: 18px; font-weight: 800; line-height: 1; }
  .mv-hv .mv-chart { flex: 1; min-height: 50px; }
  .mv-hv .tomorrow { display: flex; align-items: center; gap: 8px; border-top: 2px solid #000; padding-top: 4px; font-size: 17px; }
  .mv-hv .tomorrow svg { width: 38px; height: 38px; }
  .mv-hv .tomorrow b { font-weight: 800; }
  .mv-hv .tomorrow .lbl { font-weight: 800; text-transform: uppercase; letter-spacing: 1px; font-size: 15px; }
</style>
<div class="layout">
  {%- if days.size == 0 -%}
  <div class="mv"><p class="mv-empty">{{ T_none }} {{ generated_local | date: "%d.%m. %H:%M" }}.</p></div>
  {%- else -%}
  <div class="mv mv-hv">
    {%- assign day = days[start] -%}{% include "partials/day" %}{% include "partials/alerts" %}
    <div class="mv-head"><span class="when">{% if start == 0 %}{{ T_today }}{% else %}{{ T_tomorrow }}{% endif %}{{ alerts }}</span><span class="date">{{ day_date }}</span></div>
    <div class="hero">
      {%- assign icon = sym -%}{%- assign night = false -%}{%- assign icon_class = "" -%}
      {% include "partials/icon" %}
      <span class="mv-max">{{ tmax | round }}°</span>
      <div class="side">
        <div class="what">{% include "partials/word" %}</div>
        <div class="lo">{{ T_low }} {{ tmin | round }}°</div>
        {%- if rise -%}<div class="mv-sun">{{ rise_svg }}{{ rise }} {{ set_svg }}{{ set }}</div>{%- endif -%}
      </div>
    </div>
    <div class="mv-facts">
      <div class="mv-fact"><span>{{ T_rain }}</span><b>{% assign n = rain %}{% include "partials/dec1" %} mm</b><i>{{ chance | times: 100 | round }} %</i></div>
      <div class="mv-fact"><span>{{ T_sunshine }}</span><b>{% if shine != nil %}{% assign n = shine %}{% include "partials/dec1" %} h{% else %}–{% endif %}</b><i>{% if light %}{{ light | divided_by: 60 | floor }} h {{ light | modulo: 60 }} min{% if light_diff_s != "" %} ({{ light_diff_s }}){% endif %}{% else %}&nbsp;{% endif %}</i></div>
      <div class="mv-fact"><span>{{ T_clouds }}</span><b>{% if cloud != nil %}{{ cloud | round }} %{% else %}–{% endif %}</b><i>&nbsp;</i></div>
      <div class="mv-fact"><span>{{ T_wind }}</span><b>{{ wind | times: wind_k | round }} {{ wind_unit }}</b><i>&nbsp;</i></div>
    </div>
    {% include "partials/parts" %}
    {%- assign chart_days = day | split: "," -%}{%- assign chart_w = 360 -%}{%- assign chart_h = 94 -%}{%- assign chart_axis = true -%}{%- assign chart_labels = false -%}{%- assign chart_class = "" -%}
    {% include "partials/chart" %}
    {%- assign next_start = start | plus: 1 -%}
    {%- if days.size > next_start -%}
    {%- assign day = days[next_start] -%}{% include "partials/day" %}
    <div class="tomorrow">
      <span class="lbl">{% if start == 0 %}{{ T_tomorrow }}{% else %}{{ day_name }}{% endif %}</span>
      {%- assign icon = sym -%}{%- assign night = false -%}{%- assign icon_class = "" -%}
      {% include "partials/icon" %}
      <span><b>{{ tmax | round }}°</b> / {{ tmin | round }}°{% if rain >= 0.1 %} · {% assign n = rain %}{% include "partials/dec1" %} mm{% endif %}</span>
    </div>
    {%- endif -%}
  </div>
  {%- endif -%}
</div>
{%- assign compact = true -%}
{% include "partials/title_bar" %}
