      <span><b>{{ tmax | round }}°</b> / {{ tmin | round }}°{% if rain >= 0.1 %} · {{ rain | round: 1 | replace: ".", T_dec }} mm{% endif %}</span>
    </div>
    {%- endif -%}
  </div>
  {%- endif -%}
</div>
{%- assign compact = true -%}
{%- if lang == "cs" -%}
  {%- assign gmo = generated_local | date: "%m" | plus: 0 -%}
  {%- assign gdate = generated_local | date: "%d" | plus: 0 | append: ". " | append: gmo | append: "." -%}
{%- else -%}
  {%- assign gmo = generated_local | date: "%m" | plus: 0 | minus: 1 -%}
  {%- assign gdate = T_months[gmo] | slice: 0, 3 -%}{%- assign gdate = generated_local | date: "%d" | plus: 0 | append: " " | append: gdate -%}
{%- endif -%}
{%- assign gtime = generated_local | date: "%H:%M" -%}
{%- assign gday = generated_local | date: "%Y-%m-%d" -%}
<div class="title_bar">
  <span class="title">{{ place }}</span>
  {%- if stale -%}
  <span class="instance"><span class="mv-badge">{{ T_stale }}</span> {{ gdate }} {{ gtime }}</span>
  {%- elsif compact -%}
  <span class="instance">{% if ai %}MeteoVerdict AI{% else %}MeteoVerdict{% endif %} · {% if gday != real_today %}{{ gdate }} {% endif %}{{ gtime }}</span>
  {%- else -%}
  <span class="instance">{% if ai %}{{ T_ai }}{% else %}MeteoVerdict{% if models_used > 0 %} · {{ models_used }} {{ T_models }}{% endif %}{% endif %} · {% if gday != real_today %}{{ gdate }} {% endif %}{{ gtime }}</span>
  {%- endif -%}
</div>
