    {%- assign y = c_hi | minus: v | times: curve_h | divided_by: c_span | plus: 5 | round: 1 -%}
    {%- assign px = x | plus: 5 | round: 1 -%}
    {%- capture pt -%}{{ px }},{{ y }}{%- endcapture -%}
    {%- assign pts = pts | append: " " | append: pt -%}
  {%- endif -%}
  {%- assign p = H.precipitation[i] | default: 0 -%}
  {%- if p >= 0.1 -%}
    {%- assign bh = p | at_most: 3 | times: 0.15 | times: chart_h | plus: 2 | round: 1 -%}
    {%- assign by = floor_y | minus: bh -%}
    {%- capture bar -%}<rect x="{{ x | minus: 8.5 | round: 1 }}" y="{{ by }}" width="7" height="{{ bh }}"/>{%- endcapture -%}
    {%- assign bars = bars | append: bar -%}
  {%- endif -%}
{%- endfor -%}
<svg class="mv-chart {{ chart_class }}" viewBox="0 0 {{ cw }} {{ chart_h }}" preserveAspectRatio="none">
  {%- for cd in chart_days -%}
    {%- assign x0 = forloop.index0 | times: 240 -%}
    {%- assign crow = forecast.parts | where: "day", cd | first -%}
    {%- if crow.sunrise -%}
      {%- assign r_min = crow.sunrise | slice: 0, 2 | times: 60 -%}{%- assign r_min = crow.sunrise | slice: 3, 2 | plus: r_min -%}
      {%- assign s_min = crow.sunset | slice: 0, 2 | times: 60 -%}{%- assign s_min = crow.sunset | slice: 3, 2 | plus: s_min -%}
      <rect x="{{ x0 }}" y="0" width="{{ r_min | divided_by: 6.0 | round: 1 }}" height="{{ floor_y }}" fill="url(#mv-night)"/>
      <rect x="{{ s_min | divided_by: 6.0 | plus: x0 | round: 1 }}" y="0" width="{{ 1440 | minus: s_min | divided_by: 6.0 | round: 1 }}" height="{{ floor_y }}" fill="url(#mv-night)"/>
    {%- endif -%}
    {%- if chart_days.size == 1 -%}
      <path d="M60 0V{{ floor_y }}M120 0V{{ floor_y }}M180 0V{{ floor_y }}" stroke="#000" stroke-width="1" stroke-dasharray="2 3" vector-effect="non-scaling-stroke"/>
    {%- elsif forloop.index0 > 0 -%}
      <path d="M{{ x0 }} 0V{{ floor_y }}" stroke="#000" stroke-width="2" vector-effect="non-scaling-stroke"/>
    {%- endif -%}
  {%- endfor -%}
  <g fill="#000" stroke="#fff" stroke-width="1" vector-effect="non-scaling-stroke">{{ bars }}</g>
  <polyline points="{{ pts | strip }}" fill="none" stroke="#fff" stroke-width="8" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke"/>
  <polyline points="{{ pts | strip }}" fill="none" stroke="#000" stroke-width="3.5" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke"/>
  {%- assign now_x = now_local | minus: base | divided_by: 360.0 -%}
  {%- if now_x >= 0 and now_x < cw -%}
    <path d="M{{ now_x | round: 1 }} 0V{{ floor_y }}" stroke="#000" stroke-width="2" stroke-dasharray="4 2" vector-effect="non-scaling-stroke"/>
  {%- endif -%}
  <path d="M0 {{ floor_y | plus: 0.5 }}H{{ cw }}" stroke="#000" stroke-width="2" vector-effect="non-scaling-stroke"/>
</svg>
  <div class="sum">
    {{ T_warmest }} <b>{{ best_t_day }} {{ best_t | round }}°</b>
    {%- if best_r >= 0.5 %} · {{ T_wettest }} <b>{{ best_r_day }} {{ best_r | round: 1 | replace: ".", T_dec }} mm</b>{% endif -%}
    {%- if best_s > 0 %} · {{ T_sunniest }} <b>{{ best_s_day }} {{ best_s | round | replace: ".", T_dec }} h</b>{% endif %}
  </div>
</div>
    {%- else -%}
<style>
  .mv-tt { display: flex; gap: 22px; }
  .mv-tt .col { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 5px; }
  .mv-tt .hero { display: flex; align-items: center; gap: 6px; height: 96px; }
  .mv-tt .hero > svg { width: 92px; height: 92px; flex: none; }
  .mv-tt .temps { display: flex; flex-direction: column; flex: none; }
  .mv-tt .mv-max { font-size: 72px; }
  .mv-tt .min { font-size: 20px; font-weight: 600; margin-top: 2px; }
  .mv-tt .side { margin-left: auto; text-align: right; line-height: 1.3; }
  .mv-tt .what { font-size: 18px; font-weight: 800; margin-bottom: 4px; white-space: nowrap; }
  .mv-tt .mv-sun { font-size: 18px; }
  .mv-parts { display: grid; grid-template-columns: repeat(4, 1fr); text-align: center; }
  .mv-part .n { font-size: 12px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; }
  .mv-part svg { width: 38px; height: 38px; display: block; margin: 0 auto; }
  .mv-part .t { font-size: 19px; font-weight: 800; line-height: 1; }
  .mv-tt .mv-chart { flex: 1; min-height: 60px; }
</style>
<div class="mv mv-tt">
  {%- for day in days limit: 2 -%}
{%- assign rows = forecast.parts | where: "day", day -%}
{%- assign whole = rows | where: "part", "day" | first -%}
{%- assign tmin = 999 -%}{%- assign tmax = -999 -%}{%- assign rain = 0 -%}{%- assign chance = 0 -%}{%- assign wind = 0 -%}{%- assign cloud = nil -%}{%- assign shine = nil -%}
{%- for r in rows -%}
  {%- if r.part == "day" -%}{%- continue -%}{%- endif -%}
  {%- if r.tmin != nil and r.tmin < tmin -%}{%- assign tmin = r.tmin -%}{%- endif -%}
  {%- if r.tmax != nil and r.tmax > tmax -%}{%- assign tmax = r.tmax -%}{%- endif -%}
  {%- assign rain = rain | plus: r.precipitation -%}
  {%- if r.rain_probability > chance -%}{%- assign chance = r.rain_probability -%}{%- endif -%}
  {%- if r.wind > wind -%}{%- assign wind = r.wind -%}{%- endif -%}
  {%- if r.sunshine != nil -%}{%- assign shine = shine | plus: r.sunshine -%}{%- endif -%}
{%- endfor -%}
{%- if whole -%}
  {%- assign tmin = whole.tmin -%}{%- assign tmax = whole.tmax -%}{%- assign rain = whole.precipitation -%}
  {%- assign chance = whole.rain_probability -%}{%- assign wind = whole.wind -%}{%- assign cloud = whole.cloud -%}
  {%- assign sym = whole.symbol -%}
  {%- if whole.sunshine != nil -%}{%- assign shine = whole.sunshine -%}{%- endif -%}
{%- else -%}
  {%- assign pm = rows | where: "part", "afternoon" | first | default: rows.last -%}
  {%- assign sym = pm.symbol -%}{%- assign cloud = pm.cloud -%}
{%- endif -%}
{%- assign rise = rows.first.sunrise -%}{%- assign set = rows.first.sunset -%}{%- assign light = nil -%}
{%- if rise -%}
  {%- assign rise_min = rise | slice: 0, 2 | times: 60 -%}{%- assign rise_min = rise | slice: 3, 2 | plus: rise_min -%}
  {%- assign set_min = set | slice: 0, 2 | times: 60 -%}{%- assign set_min = set | slice: 3, 2 | plus: set_min -%}
  {%- assign light = set_min | minus: rise_min -%}
{%- endif -%}
{%- assign noon = day | append: "T12:00:00Z" -%}
{%- assign wd = noon | date: "%w" | plus: 0 -%}
{%- assign mo = noon | date: "%m" | plus: 0 | minus: 1 -%}
{%- assign day_num = noon | date: "%d" | plus: 0 -%}
{%- assign day_name = T_days[wd] -%}{%- assign day_short = T_days_short[wd] -%}
{%- if lang == "cs" -%}
  {%- assign day_long = day_name | append: " " | append: day_num | append: ". " | append: T_months[mo] -%}
{%- else -%}
  {%- assign day_long = day_name | append: " " | append: day_num | append: " " | append: T_months[mo] -%}
{%- endif -%}
    <div class="col">
      <div class="mv-head">
        <span class="when">{% if forloop.first %}{{ T_today }}{% else %}{{ T_tomorrow }}{% endif %}</span>
        <span class="date">{{ day_long }}</span>
      </div>
      <div class="hero">
        {%- assign icon = sym -%}{%- assign night = false -%}{%- assign icon_class = "" -%}
{%- if night -%}{%- assign orb = moon -%}{%- else -%}{%- assign orb = sun -%}{%- endif -%}
<svg class="{{ icon_class }}" viewBox="0 0 64 64">
  {%- case icon -%}
  {%- when "clear" -%}{{ orb }}
  {%- when "partly" -%}<g transform="translate(2 0) scale(.62)">{{ orb }}</g>{{ cloud_svg }}
  {%- when "cloudy" -%}<g transform="translate(-8 -12)">{{ cloud_svg | replace: '#fff', '#000' }}</g>{{ cloud_svg }}
  {%- when "showers" -%}<g transform="translate(2 -6) scale(.62)">{{ orb }}</g><g transform="translate(0 -8)">{{ cloud_svg }}</g>{{ drop1 }}
  {%- when "rain" -%}<g transform="translate(0 -8)">{{ cloud_svg }}</g>{{ drops }}
  {%- when "sleet" -%}<g transform="translate(0 -8)">{{ cloud_svg }}</g>{{ sleet }}
  {%- when "snow" -%}<g transform="translate(0 -8)">{{ cloud_svg }}</g>{{ flakes }}
  {%- endcase -%}
</svg>
        <div class="temps">
          <span class="mv-max">{{ tmax | round }}°</span>
          <span class="min">{{ T_low }} {{ tmin | round }}°</span>
        </div>
        <div class="side">
          <div class="what">
{%- for s in SYMBOLS -%}{%- if s == icon -%}{{ T_symbols[forloop.index0] }}{%- endif -%}{%- endfor -%}</div>
          {%- if rise -%}
          <div class="mv-sun">{{ rise_svg }} {{ rise }}</div>
          <div class="mv-sun">{{ set_svg }} {{ set }}</div>
          {%- endif -%}
        </div>
      </div>
      <div class="mv-facts">
        <div class="mv-fact"><span>{{ T_rain }}</span><b>{{ rain | round: 1 | replace: ".", T_dec }} mm</b><i>{{ chance | times: 100 | round }} % {{ T_chance }}</i></div>
        <div class="mv-fact"><span>{{ T_sunshine }}</span><b>{% if shine != nil %}{{ shine | round: 1 | replace: ".", T_dec }} h{% else %}–{% endif %}</b><i>{% if light %}{{ T_of }} {{ light | divided_by: 60 | floor }} h {{ light | modulo: 60 }} min{% endif %}</i></div>
        <div class="mv-fact"><span>{{ T_clouds }}</span><b>{% if cloud != nil %}{{ cloud | round }} %{% else %}–{% endif %}</b><i>{{ T_daytime }}</i></div>
        <div class="mv-fact"><span>{{ T_wind }}</span><b>{{ wind | round }} m/s</b><i>{{ T_max }}</i></div>
      </div>
<div class="mv-parts">
  {%- assign part_names = "night,morning,afternoon,evening" | split: "," -%}
  {%- for part in part_names -%}
    {%- assign p = rows | where: "part", part | first -%}
    <div class="mv-part">
      <div class="n">{{ T_parts[forloop.index0] }}</div>
      {%- if p -%}
        {%- assign icon = p.symbol -%}{%- assign icon_class = "" -%}
        {%- if part == "night" or part == "evening" -%}{%- assign night = true -%}{%- else -%}{%- assign night = false -%}{%- endif -%}
{%- if night -%}{%- assign orb = moon -%}{%- else -%}{%- assign orb = sun -%}{%- endif -%}
<svg class="{{ icon_class }}" viewBox="0 0 64 64">
  {%- case icon -%}
  {%- when "clear" -%}{{ orb }}
  {%- when "partly" -%}<g transform="translate(2 0) scale(.62)">{{ orb }}</g>{{ cloud_svg }}
  {%- when "cloudy" -%}<g transform="translate(-8 -12)">{{ cloud_svg | replace: '#fff', '#000' }}</g>{{ cloud_svg }}
  {%- when "showers" -%}<g transform="translate(2 -6) scale(.62)">{{ orb }}</g><g transform="translate(0 -8)">{{ cloud_svg }}</g>{{ drop1 }}
  {%- when "rain" -%}<g transform="translate(0 -8)">{{ cloud_svg }}</g>{{ drops }}
  {%- when "sleet" -%}<g transform="translate(0 -8)">{{ cloud_svg }}</g>{{ sleet }}
  {%- when "snow" -%}<g transform="translate(0 -8)">{{ cloud_svg }}</g>{{ flakes }}
  {%- endcase -%}
</svg>
        <div class="t">{% if part == "night" %}{{ p.tmin | round }}{% else %}{{ p.tmax | round }}{% endif %}°</div>
      {%- else -%}
        <svg viewBox="0 0 64 64"></svg><div class="t">–</div>
      {%- endif -%}
    </div>
  {%- endfor -%}
</div>
      {%- assign chart_days = day | split: "," -%}{%- assign chart_h = 74 -%}{%- assign chart_class = "" -%}
{%- assign cw = chart_days.size | times: 240 -%}
{%- assign base = chart_days.first | append: "T00:00:00Z" | date: "%s" | plus: 0 -%}
{%- assign floor_y = chart_h | minus: 4 -%}
{%- assign curve_h = chart_h | times: 0.6 -%}
{%- assign c_lo = 99 -%}{%- assign c_hi = -99 -%}
{%- for t in H.time -%}
  {%- assign x = t | date: "%s" | plus: offset | minus: base | divided_by: 360.0 -%}
  {%- if x < 0 or x >= cw -%}{%- continue -%}{%- endif -%}
  {%- assign v = H.temperature_2m[forloop.index0] -%}
  {%- if v != nil -%}
    {%- if v < c_lo -%}{%- assign c_lo = v -%}{%- endif -%}
    {%- if v > c_hi -%}{%- assign c_hi = v -%}{%- endif -%}
  {%- endif -%}
{%- endfor -%}
{%- assign c_span = c_hi | minus: c_lo | at_least: 4 -%}
{%- assign pts = "" -%}{%- assign bars = "" -%}
{%- for t in H.time -%}
  {%- assign x = t | date: "%s" | plus: offset | minus: base | divided_by: 360.0 -%}
  {%- if x < 0 or x >= cw -%}{%- continue -%}{%- endif -%}
  {%- assign i = forloop.index0 -%}
  {%- assign v = H.temperature_2m[i] -%}
  {%- if v != nil -%}
    {%- assign y = c_hi | minus: v | times: curve_h | divided_by: c_span | plus: 5 | round: 1 -%}
    {%- assign px = x | plus: 5 | round: 1 -%}
    {%- capture pt -%}{{ px }},{{ y }}{%- endcapture -%}
    {%- assign pts = pts | append: " " | append: pt -%}
  {%- endif -%}
  {%- assign p = H.precipitation[i] | default: 0 -%}
  {%- if p >= 0.1 -%}
    {%- assign bh = p | at_most: 3 | times: 0.15 | times: chart_h | plus: 2 | round: 1 -%}
    {%- assign by = floor_y | minus: bh -%}
    {%- capture bar -%}<rect x="{{ x | minus: 8.5 | round: 1 }}" y="{{ by }}" width="7" height="{{ bh }}"/>{%- endcapture -%}
    {%- assign bars = bars | append: bar -%}
  {%- endif -%}
{%- endfor -%}
<svg class="mv-chart {{ chart_class }}" viewBox="0 0 {{ cw }} {{ chart_h }}" preserveAspectRatio="none">
  {%- for cd in chart_days -%}
    {%- assign x0 = forloop.index0 | times: 240 -%}
    {%- assign crow = forecast.parts | where: "day", cd | first -%}
    {%- if crow.sunrise -%}
      {%- assign r_min = crow.sunrise | slice: 0, 2 | times: 60 -%}{%- assign r_min = crow.sunrise | slice: 3, 2 | plus: r_min -%}
      {%- assign s_min = crow.sunset | slice: 0, 2 | times: 60 -%}{%- assign s_min = crow.sunset | slice: 3, 2 | plus: s_min -%}
      <rect x="{{ x0 }}" y="0" width="{{ r_min | divided_by: 6.0 | round: 1 }}" height="{{ floor_y }}" fill="url(#mv-night)"/>
      <rect x="{{ s_min | divided_by: 6.0 | plus: x0 | round: 1 }}" y="0" width="{{ 1440 | minus: s_min | divided_by: 6.0 | round: 1 }}" height="{{ floor_y }}" fill="url(#mv-night)"/>
    {%- endif -%}
    {%- if chart_days.size == 1 -%}
      <path d="M60 0V{{ floor_y }}M120 0V{{ floor_y }}M180 0V{{ floor_y }}" stroke="#000" stroke-width="1" stroke-dasharray="2 3" vector-effect="non-scaling-stroke"/>
    {%- elsif forloop.index0 > 0 -%}
      <path d="M{{ x0 }} 0V{{ floor_y }}" stroke="#000" stroke-width="2" vector-effect="non-scaling-stroke"/>
    {%- endif -%}
  {%- endfor -%}
  <g fill="#000" stroke="#fff" stroke-width="1" vector-effect="non-scaling-stroke">{{ bars }}</g>
  <polyline points="{{ pts | strip }}" fill="none" stroke="#fff" stroke-width="8" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke"/>
  <polyline points="{{ pts | strip }}" fill="none" stroke="#000" stroke-width="3.5" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke"/>
  {%- assign now_x = now_local | minus: base | divided_by: 360.0 -%}
  {%- if now_x >= 0 and now_x < cw -%}
    <path d="M{{ now_x | round: 1 }} 0V{{ floor_y }}" stroke="#000" stroke-width="2" stroke-dasharray="4 2" vector-effect="non-scaling-stroke"/>
  {%- endif -%}
  <path d="M0 {{ floor_y | plus: 0.5 }}H{{ cw }}" stroke="#000" stroke-width="2" vector-effect="non-scaling-stroke"/>
</svg>
    </div>
  {%- endfor -%}
</div>
    {%- endcase -%}
  </div>
  {%- assign compact = false -%}
<div class="title_bar">
  <span class="title">{{ place }}</span>
  {%- assign updated = forecast.generated | date: "%s" | plus: offset -%}
  {%- if compact -%}
  <span class="instance">MeteoVerdict · {{ updated | date: "%H:%M" }}</span>
  {%- else -%}
  <span class="instance">MeteoVerdict{% if models_used > 0 %} · {{ models_used }} {{ T_models }}{% endif %} · {{ T_updated }} {{ updated | date: "%-d.%-m. %H:%M" }}</span>
  {%- endif -%}
</div>
</div>
